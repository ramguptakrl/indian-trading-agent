# LLM provider key — required only for AI-powered Deep Analysis / reflection.
# Pick the provider configured in the app. The non-LLM Trade Brain evidence/replay
# components can still run without an LLM key.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: other LLM providers
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Optional: additional vendor market data
# ALPHA_VANTAGE_API_KEY=

# Zerodha Kite MARKET_DATA_ONLY transport.
# These are OPTIONAL. Without them, Trade Brain explicitly falls back to its Yahoo
# research data path. The Kite adapter exposes instruments, REST quotes, historical
# candles and WebSocket live market quotes only. It exposes no place/modify/cancel
# order methods and does not change the modeled RESIDENT_INDIAN trader profile even
# if the credential belongs to an NRI account.
#
# Runtime data calls require API key + access token. API secret is used only during
# the normal Kite login/token-exchange flow that obtains the access token.
# KITE_API_KEY=
# KITE_API_SECRET=
# KITE_ACCESS_TOKEN=  # Zerodha access tokens are session/login-flow dependent
#
# Optional standalone live quote process:
#   python scripts/tradebrain_kite_live_stream.py
# KITE_LIVE_SUBSCRIPTIONS=NSE:BSE
# KITE_LIVE_MODE=quote  # ltp | quote | full
